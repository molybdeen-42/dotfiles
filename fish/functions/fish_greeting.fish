function fish_greeting
    set -l y (set_color FFD700) # yellow body
    set -l t (set_color 00AFAF) # teal outline/stripes
    set -l w (set_color FFFFFF) # white wing details
    set -l i (set_color FFFACD) # light yellow stripe & eye details
    set -l b (set_color 1C1C1C) # Black outline
    set -l n (set_color normal) # Regular text color

    echo "        
                     ; 
                     = 
                    ‐=‐
                    ===
             /≈≈   ‐===‐
             ≈≈≈   ====
            ≈≈/:--≊‑=;
         ‐==::-‑≊-:≊‑
       ≊:=====:-≊≊‑--
      ≊≊:======:-≊꞉/≈≈
      --========:-≈≈≈≈
      =====---===:≈≈≈/
      --==:≊≊≊:=‐===‐
     -≈--=:≊꞉≊:===‐
       --=:≊≊≊:=‐
        -≈=---=
         -
    " | sed \
        -e "s/[‐=;]/$y&$n/g" \
        -e "s/[≈/]/$w&$n/g" \
        -e "s/[‑≊]/$i&$n/g" \
        -e "s/[,꞉]/$b&$n/g" \
        -e "s/[.:\-]/$t&$n/g"

    echo -n "Welcome back "
    set_color --bold purple
    echo -n $USER
    set_color normal
    echo "!"
    echo -n "This is your personal assistant, "
    set_color FFD700
    echo -n "Shellsparce"
    set_color normal
    echo "." 
end

